{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abrajan-tree-landscape",
  "main": "workers/index.js",
  "compatibility_date": "2026-10-20",
  "ratelimits": [
    {
      "name": "GOOGLE_REVIEWS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
}
