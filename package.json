{
  "name": "abrajan-tree-landscape",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "preview:cloudflare": "npm run build && wrangler pages dev -c wrangler.jsonc -c wrangler.api.jsonc",
    "dev:api": "wrangler dev -c wrangler.workers.jsonc --ip 127.0.0.1 --port 8787",
    "deploy:api": "wrangler deploy -c wrangler.api.jsonc",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:workers": "npm run build && wrangler deploy -c wrangler.workers.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "0.35.5",
    "typescript": "~5.9.3",
    "wrangler": "4.151.3"
  }
}
