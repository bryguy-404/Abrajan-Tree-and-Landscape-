---
import Icon from './Icon.astro';
import { locationLabel, estimateHref } from '../data/business';
import type { ServiceImage } from '../data/service-images';
interface Props {
  image: ServiceImage;
}
const { image } = Astro.props;
---

<section class="removal-hero" data-page-hero aria-labelledby="service-title">
  <img class="removal-background" {...image} fetchpriority="high" />
  <div class="removal-shade"></div>
  <div class="container removal-hero-inner">
    <nav class="service-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/services/tree-services/">Tree Services</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Tree Removal</span>
    </nav>
    <div class="removal-hero-copy">
      <p class="eyebrow light">
        <span class="eyebrow-line"></span> MAKE ROOM FOR WHAT’S NEXT
      </p>
      <h1 id="service-title">
        Tree Removal <span>in {locationLabel}.</span>
      </h1>
      <p class="removal-lead">
        A big decision for your property.
        <br />
        An experienced team for the work.
      </p>
      <p class="removal-description">
        From a damaged tree to a planned change, we’ll talk through the removal,
        the surroundings, and what you want to leave behind.
      </p>
      <div class="removal-actions">
        <a class="button button-lime" href={estimateHref('Tree removal')}>
          Get a Free Removal Estimate <Icon name="diagonal" size={20} />
        </a>
        <a class="removal-process-link" href="#removal-planning">
          See How We Plan the Work <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
    <div class="removal-hero-bottom">
      <span>
        <Icon name="shield" size={18} /> Licensed & Insured
      </span>
      <span class="removal-image-note">
        AI-generated illustration · Client photos coming soon
      </span>
    </div>
  </div>
</section>
<div class="removal-confidence">
  <div class="container">
    <span>
      <Icon name="home" size={23} />
      <strong>Local Roots</strong>
      <small>Serving Michiana since 2000</small>
    </span>
    <span>
      <Icon name="leaf" size={23} />
      <strong>Free Estimates</strong>
      <small>A clear conversation from the start</small>
    </span>
    <a href="/services/tree-services/#emergency">
      <Icon name="storm" size={23} />
      <strong>24/7 Emergency Service</strong>
      <small>
        Tree work after storm damage <Icon name="arrow" size={14} />
      </small>
    </a>
  </div>
</div>
<style>
  .removal-hero {
    position: relative;
    isolation: isolate;
    background: var(--deep);
    color: #fff;
    padding: 170px 0 28px;
    min-height: 800px;
  }
  .removal-background,
  .removal-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .removal-background {
    object-fit: cover;
    object-position: 58% 25%;
  }
  .removal-shade {
    background:
      linear-gradient(90deg, #071f17ed 0%, #08251bc9 32%, #08251b30 70%),
      linear-gradient(
        180deg,
        #061e19a6,
        transparent 35%,
        #061e1955 80%,
        #061e19c2
      );
  }
  .removal-hero-inner {
    display: flex;
    flex-direction: column;
    min-height: 602px;
  }
  .service-breadcrumb {
    margin-bottom: 55px;
  }
  .removal-hero-copy {
    max-width: 600px;
    margin-bottom: 60px;
  }
  h1 {
    font-size: clamp(55px, 5.5vw, 80px);
    line-height: 1.08;
    letter-spacing: -3px;
    font-weight: 500;
  }
  h1 span {
    display: block;
    color: var(--lime);
    font-size: 0.5em;
    line-height: 1.3;
    letter-spacing: -1.3px;
    margin-top: 14px;
  }
  .removal-lead {
    margin-top: 30px;
    color: #fff;
    font-size: 23px;
    line-height: 1.5;
    letter-spacing: -0.5px;
  }
  .removal-description {
    font-size: 14px;
    line-height: 1.9;
    color: #d0dccd;
    max-width: 440px;
    margin-top: 18px;
  }
  .removal-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    margin-top: 30px;
  }
  .removal-process-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
  }
  .removal-process-link :global(svg) {
    transform: rotate(90deg);
  }
  .removal-hero-bottom {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid #ffffff35;
    display: flex;
    gap: 20px;
    justify-content: space-between;
    align-items: center;
  }
  .removal-hero-bottom > span:first-child {
    display: flex;
    gap: 9px;
    align-items: center;
    font-size: 11px;
  }
  .removal-hero-bottom :global(svg) {
    color: var(--lime);
  }
  .removal-image-note {
    font-size: 9px;
    color: #e2e9d9;
    background: #09271980;
    padding: 4px 8px;
    border-radius: 3px;
  }
  .removal-confidence {
    background: var(--cream);
    border-bottom: 1px solid var(--line);
    padding: 27px 0;
  }
  .removal-confidence > .container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .removal-confidence .container > * {
    display: grid;
    grid-template-columns: 26px 1fr;
    column-gap: 13px;
    align-items: center;
  }
  .removal-confidence strong {
    font-size: 13px;
    font-weight: 600;
  }
  .removal-confidence small {
    grid-column: 2;
    color: var(--muted);
    font-size: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .removal-confidence .container > :global(svg) {
    color: #738b3c;
  }
  .removal-confidence a:hover strong {
    color: #627c38;
  }
  @media (max-width: 1100px) {
    .removal-hero-copy {
      max-width: 540px;
    }
    .removal-shade {
      background:
        linear-gradient(90deg, #071f17ed, #08251bb8 50%, #08251b45),
        linear-gradient(180deg, #061e19a6, transparent 40%, #061e1955);
    }
  }
  @media (max-width: 760px) {
    .removal-hero {
      padding-top: 140px;
      min-height: 0;
    }
    .removal-hero-inner {
      min-height: 650px;
    }
    .removal-background {
      object-position: 88% center;
    }
    .removal-shade {
      background:
        linear-gradient(90deg, #071f17e6, #08251b9c),
        linear-gradient(180deg, #061e1980, transparent 50%, #061e19b8);
    }
    .service-breadcrumb {
      margin-bottom: 44px;
    }
    h1 {
      font-size: 59px;
    }
    .removal-hero-copy {
      margin-bottom: 58px;
    }
    .removal-lead {
      font-size: 21px;
    }
    .removal-hero-bottom {
      flex-wrap: wrap;
      gap: 14px;
    }
    .removal-confidence > .container {
      gap: 18px;
    }
    .removal-confidence strong {
      font-size: 11px;
    }
    .removal-confidence small {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .removal-hero {
      padding-top: 130px;
    }
    .removal-confidence > .container {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .removal-confidence small {
      display: flex;
    }
    .removal-confidence strong {
      font-size: 12px;
    }
    .removal-actions .button {
      font-size: 12px;
      gap: 15px;
      padding-inline: 22px;
    }
  }
  @media (max-width: 360px) {
    h1 {
      font-size: 47px;
      letter-spacing: -2px;
    }
    h1 span {
      font-size: 0.57em;
    }
    .removal-actions .button {
      font-size: 11px;
      padding-inline: 19px;
    }
    .removal-image-note {
      font-size: 8px;
    }
  }
</style>
