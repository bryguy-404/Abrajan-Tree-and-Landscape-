---
import Icon from './Icon.astro';
---

<footer class="site-footer">
  <div class="container footer-top">
    <a class="brand footer-brand" href="/" aria-label="Abrajan home">
      <span class="brand-window">
        <img
          src="/images/abrajan-logo.webp"
          width="700"
          height="350"
          alt="Abrajan Tree & Complete Landscaping Service"
          loading="lazy"
        />
      </span>
    </a>
    <p>
      Tree Care With Local Roots.
      <br />
      <span>Serving Michiana Since 2000.</span>
    </p>
    <a class="back-top" href="#top">
      Back to Top{' '}
      <span>
        <Icon name="arrow" size={20} />
      </span>
    </a>
  </div>
  <div class="container footer-bottom">
    <span>
      © {new Date().getFullYear()} Abrajan Tree & Complete Landscaping Service.
    </span>
    <nav aria-label="Footer navigation">
      <a href="/about/">About</a>
      <a href="/services/tree-services/">Services</a>
      <a href="/#our-work">Our Work</a>
      <a href="/reviews/">Reviews</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
  </div>
  <div class="container footer-credit">
    <span>Designed By:</span>
    <a
      href="https://bryandevelops.com/"
      target="_blank"
      rel="noopener noreferrer"
    >
      Bryan Develops
    </a>
  </div>
</footer>

<style>
  .footer-credit {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 22px;
    font-size: 11px;
    color: #a1b7aa;
  }
  .footer-credit a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 0;
    color: var(--lime);
    font-size: 15px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-thickness 0.2s;
  }
  .footer-credit a:hover {
    text-decoration-thickness: 2px;
  }
  @media (max-width: 760px) {
    .footer-credit {
      justify-content: flex-start;
    }
  }
</style>
