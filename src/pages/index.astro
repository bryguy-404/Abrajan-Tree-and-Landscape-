---
import SiteLayout from '../layouts/SiteLayout.astro';
import { locationLabel, primaryLocation } from '../data/business';
import Icon from '../components/Icon.astro';
import SectionContours from '../components/SectionContours.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import ServiceArea from '../components/ServiceArea.astro';
import TreeServices from '../components/TreeServices.astro';
import EstimateForm from '../components/EstimateForm.astro';
const faqs = [
  {
    question: 'Can I get a free estimate?',
    answer:
      'Yes. Estimates are free. We’ll talk through your tree or property needs and the work you have in mind before planning the next step.',
  },
  {
    question: 'Do you work with homes and businesses?',
    answer:
      'Yes. We handle tree removal, trimming, stump grinding, and property care for residential and commercial properties across Michiana.',
  },
  {
    question: 'Are you licensed and insured?',
    answer:
      'Yes. Abrajan Tree & Complete Landscaping Service is licensed and insured.',
  },
  {
    question: 'Do you offer emergency tree service?',
    answer:
      'Yes. Abrajan offers 24/7 emergency tree service for storm damage, fallen trees, and broken limbs. Online estimate requests are not an emergency dispatch service.',
  },
];
---

<SiteLayout
  title={`Tree Removal & Tree Services in ${locationLabel} | Abrajan`}
  description={`Tree removal, trimming, stump grinding, and 24/7 emergency tree service in ${locationLabel} and across Michiana. Serving the area since 2000. Free estimates.`}
  image="/images/hero-landscape.webp"
>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <img
        class="hero-image"
        src="/images/hero-landscape.webp"
        alt="Illustrative aerial view of a lush garden, green lawn, and winding path"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="hero-shade"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow light">
            <span class="eyebrow-line"></span>{' '}
            {primaryLocation.city.toUpperCase()},{' '}
            {primaryLocation.state.toUpperCase()} • SINCE 2000
          </p>
          <h1 id="hero-title">
            Tree Removal.
            <br />
            Expert Care.
            <br />
            <span>Local Roots.</span>
          </h1>
          <p class="hero-description">
            Tree removal, trimming, stump grinding, and 24/7 storm damage
            service in {primaryLocation.city} and across Michiana. Experienced
            hands for the place you call home.
          </p>
          <div class="hero-actions">
            <a class="button button-lime" href="#contact">
              Get a Free Estimate <Icon name="diagonal" size={20} />
            </a>
            <a class="button button-outline" href="/services/tree-services/">
              Explore Tree Services <Icon name="arrow" size={20} />
            </a>
          </div>
        </div>
        <div class="hero-bottom">
          <span>
            <span class="status-dot"></span> 24/7 EMERGENCY & STORM DAMAGE
            SERVICE
          </span>
          <a href="#about" class="scroll-cue">
            Meet Your Local Tree Crew{' '}
            <span>
              <Icon name="arrow" size={18} />
            </span>
          </a>
        </div>
      </div>
    </section>
    <div class="trust-strip">
      <div class="container trust-inner">
        <div>
          <Icon name="shield" size={29} />
          <span>
            Licensed & Insured<small>Peace of mind comes standard.</small>
          </span>
        </div>
        <div>
          <Icon name="leaf" size={29} />
          <span>
            Free, Personal Estimates
            <small>Clear plans for your trees and property.</small>
          </span>
        </div>
        <div>
          <Icon name="home" size={29} />
          <span>
            Serving Michiana Since 2000
            <small>Local Roots. Experienced crews.</small>
          </span>
        </div>
      </div>
    </div>
    <TreeServices />
    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="container about-grid">
        <div class="about-visual reveal">
          <img
            src="/images/abrajan-crew.webp"
            width="800"
            height="553"
            alt="The Abrajan Tree & Complete Landscaping Service team"
            loading="lazy"
          />
          <div class="photo-caption">
            <span class="status-dot"></span> YOUR LOCAL ABRAJAN TEAM
          </div>
          <div class="about-note">
            <Icon name="leaf" size={37} />
            <span>
              Serving Michiana.
              <br />
              <strong>Since 2000.</strong>
            </span>
          </div>
        </div>
        <div class="about-copy reveal">
          <p class="eyebrow">
            <span class="eyebrow-line"></span> A LITTLE ABOUT ABRAJAN
          </p>
          <h2 id="about-title">
            Local Roots.
            <br />
            Experienced Hands.
          </h2>
          <p class="section-lead">
            Tree work is personal when it’s your home underneath it.
          </p>
          <p>
            We’ve been serving Michiana since 2000, helping homeowners and
            businesses care for their trees and the property around them. From
            planned removals to storm damage, tree work is at the heart of what
            we do.
          </p>
          <p>
            We listen to what you need, talk through the work, and bring an
            experienced crew. And when your landscape needs attention, you
            already know a team who can help.
          </p>
          <div class="about-checks">
            <span>
              <Icon name="check" size={18} /> Experienced, Dedicated Crews
            </span>
            <span>
              <Icon name="check" size={18} /> Care That Fits Your Property
            </span>
          </div>
          <a class="text-link" href="/about/">
            Meet Your Local Tree Crew <Icon name="diagonal" size={22} />
          </a>
        </div>
      </div>
    </section>
    <section
      class="seasonal"
      id="property-care"
      aria-labelledby="seasonal-title"
    >
      <SectionContours tone="dark" />
      <div class="container seasonal-grid">
        <div class="seasonal-intro reveal">
          <p class="eyebrow light">
            <span class="eyebrow-line"></span> MORE CARE FOR YOUR PROPERTY
          </p>
          <h2 id="seasonal-title">
            Beyond the Trees.
            <br />
            <span>The Whole Property.</span>
          </h2>
          <p>
            Tree work comes first. Landscaping, land clearing, and ongoing
            property care bring everything else together—with the same local
            team you already know.
          </p>
          <a
            class="button button-lime"
            href="#contact"
            data-service="Landscaping & mulch"
          >
            Plan Your Property Care <Icon name="diagonal" size={20} />
          </a>
        </div>
        <div class="season-list reveal">
          <div>
            <span class="season-icon">
              <Icon name="leaf" size={27} />
            </span>
            <div>
              <h3>
                <a href="/services/land-clearing/">
                  Land Clearing <Icon name="diagonal" size={17} />
                </a>
              </h3>
              <p>Open up space and clear overgrowth for a fresh start.</p>
            </div>
            <span class="season-label">CLEAR</span>
          </div>
          <div>
            <span class="season-icon">
              <Icon name="sun" size={27} />
            </span>
            <div>
              <h3>
                <a href="/services/landscaping/">
                  Landscaping <Icon name="diagonal" size={17} />
                </a>
              </h3>
              <p>Mulch, planting, stone, and thoughtful finishing touches.</p>
            </div>
            <span class="season-label">REFRESH</span>
          </div>
          <div>
            <span class="season-icon">
              <Icon name="tree" size={27} />
            </span>
            <div>
              <h3>
                <a href="/services/cleanups/">
                  Property Cleanups <Icon name="diagonal" size={17} />
                </a>
              </h3>
              <p>Seasonal cleanups, leaf hauling, and gutter cleaning.</p>
            </div>
            <span class="season-label">RESTORE</span>
          </div>
          <div>
            <span class="season-icon">
              <Icon name="sun" size={27} />
            </span>
            <div>
              <h3>
                <a href="/services/lawn-care/">
                  Lawn Care <Icon name="diagonal" size={17} />
                </a>
              </h3>
              <p>
                Mowing, edging, and hedge trimming through the growing season.
              </p>
            </div>
            <span class="season-label">MAINTAIN</span>
          </div>
          <div>
            <span class="season-icon">
              <Icon name="snow" size={27} />
            </span>
            <div>
              <h3>
                <a href="/services/snow-ice-management/">
                  Snow & Ice Management <Icon name="diagonal" size={17} />
                </a>
              </h3>
              <p>Plowing, shoveling, and salting for winter access.</p>
            </div>
            <span class="season-label">PREPARE</span>
          </div>
        </div>
      </div>
    </section>
    <section class="section work" id="our-work" aria-labelledby="work-title">
      <div class="container">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">
              <Icon name="leaf" size={18} /> A LITTLE BEFORE. A BEAUTIFUL AFTER.
            </p>
            <h2 id="work-title">
              Good Work.
              <br />
              <span>Right in Your Backyard.</span>
            </h2>
          </div>
          <p>
            A little attention can change everything.
            <br class="desktop-break" /> Slide to explore the before and after.
          </p>
        </div>
      </div>
      <BeforeAfterGallery />
    </section>
    <CustomerReviews />
    <section class="process-section" aria-labelledby="process-title">
      <SectionContours />
      <div class="container">
        <div class="process-intro reveal">
          <p class="eyebrow">
            <span class="eyebrow-line"></span> SIMPLE FROM THE START
          </p>
          <h2 id="process-title">
            Better Tree Care Starts
            <br />
            With a Conversation.
          </h2>
        </div>
        <div class="process-grid">
          <div class="reveal">
            <span class="step-number">01</span>
            <h3>Tell Us About Your Trees</h3>
            <p>
              A tree to remove, branches to trim, or a stump in the way. Start
              with what your property needs.
            </p>
          </div>
          <div class="reveal">
            <span class="step-number">02</span>
            <h3>Let’s Make a Plan</h3>
            <p>
              We’ll talk through your property’s needs and provide a free
              estimate for the work.
            </p>
          </div>
          <div class="reveal">
            <span class="step-number">03</span>
            <h3>Leave the Work to Us</h3>
            <p>
              Our crew takes care of the work, so you have more time for the
              good things outside.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="section faq-section" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="reveal">
          <p class="eyebrow">
            <span class="eyebrow-line"></span> GOOD TO KNOW
          </p>
          <h2 id="faq-title">
            A Few Questions,
            <br />
            Answered.
          </h2>
          <p>
            Have something else in mind?
            <br />
            <a class="text-link" href="#contact">
              Let’s Talk About Your Project <Icon name="diagonal" size={20} />
            </a>
          </p>
        </div>
        <div class="faq-list reveal">
          {faqs.map((faq, index) => (
            <details name="faq" open={index === 0}>
              <summary>
                {faq.question}
                <Icon name="plus" size={20} />
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <ServiceArea />
    <section
      class="contact-section"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="container contact-grid">
        <div class="contact-copy reveal">
          <p class="eyebrow light">
            <span class="eyebrow-line"></span> LET’S TALK TREES
          </p>
          <h2 id="contact-title">
            Your Trees.
            <br />
            Our Next Project.
          </h2>
          <p>
            Tell us what needs attention, where you’re located, and what you
            have in mind. We’ll start with a free estimate.
          </p>
          <div class="contact-location">
            <Icon name="pin" size={20} /> Serving homes & businesses throughout
            Michiana.
          </div>
        </div>
        <EstimateForm />
      </div>
    </section>
  </main>
</SiteLayout>
