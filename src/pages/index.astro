---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SectionContours from '../components/SectionContours.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import MobileNavigation from '../components/MobileNavigation.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import ServiceArea from '../components/ServiceArea.astro';
import TreeServices from '../components/TreeServices.astro';
import { estimateServiceOptions } from '../data/services';

const formEnabled = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true';
const faqs = [
  {
    question: 'Can I get a free estimate?',
    answer:
      'Yes. Estimates are free. We’ll talk through your tree or property needs and the work you have in mind before planning the next step.',
  },
  {
    question: 'Do you work with homes and businesses?',
    answer:
      'Yes. We handle tree removal, trimming, stump grinding, and property care for residential and commercial properties across Michiana.',
  },
  {
    question: 'Are you licensed and insured?',
    answer:
      'Yes. Abrajan Tree & Complete Landscaping Service is licensed and insured.',
  },
  {
    question: 'Do you offer emergency tree service?',
    answer:
      'Yes. Abrajan offers 24/7 emergency tree service for storm damage, fallen trees, and broken limbs. Online estimate requests are not an emergency dispatch service.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123c2c" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Tree removal, 24/7 emergency tree service, trimming, and stump grinding across Michiana. Serving South Bend and surrounding communities since 2000. Free estimates."
    />
    <meta
      property="og:title"
      content="Abrajan — Tree Service in Michiana Since 2000"
    />
    <meta
      property="og:description"
      content="Local Roots. Expert tree care. Tree removal, trimming, stump grinding, and 24/7 storm damage service across Michiana."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/hero-landscape.webp" />
    <title>Abrajan | Tree Removal & Tree Service in Michiana</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/images/hero-landscape.webp" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="topbar">
      <div class="container topbar-inner">
        <span>
          <Icon name="pin" size={15} /> Serving Michiana Since 2000
        </span>
        <div>
          <span class="topbar-assurance">
            <Icon name="shield" size={15} /> Licensed & Insured
          </span>
          <a
            href="#emergency-tree-service"
            aria-label="24/7 emergency tree service"
          >
            <Icon name="storm" size={15} /> 24/7 Emergency Service
          </a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container nav-inner">
        <a
          class="brand"
          href="#top"
          aria-label="Abrajan Tree & Complete Landscaping Service home"
        >
          <span class="brand-window">
            <img
              src="/images/abrajan-logo.webp"
              width="700"
              height="350"
              alt="Abrajan Tree & Complete Landscaping Service"
            />
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a
            href="#top"
            class="active"
            data-nav-section="top"
            aria-current="location"
          >
            Home
          </a>
          <a href="#services" data-nav-section="services">
            Tree Services
          </a>
          <a href="#about" data-nav-section="about">
            About Us
          </a>
          <a href="#our-work" data-nav-section="our-work">
            Our Work
          </a>
          <a href="#reviews" data-nav-section="reviews">
            Reviews
          </a>
          <a href="#contact" data-nav-section="contact">
            Contact
          </a>
        </nav>
        <a class="button button-lime nav-cta" href="#contact">
          Get a Free Estimate <Icon name="diagonal" size={19} />
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-haspopup="dialog"
        >
          <span class="menu-label" aria-hidden="true">
            Menu
          </span>
          <span class="menu-lines" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </header>
    <MobileNavigation />
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src="/images/hero-landscape.webp"
          alt="Illustrative aerial view of a lush garden, green lawn, and winding path"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <div class="hero-shade"></div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow light">
              <span class="eyebrow-line"></span> MICHIANA TREE SERVICE • SINCE
              2000
            </p>
            <h1 id="hero-title">
              Tree Removal.
              <br />
              Expert Care.
              <br />
              <span>Local Roots.</span>
            </h1>
            <p class="hero-description">
              Tree removal, trimming, stump grinding, and 24/7 storm damage
              service. Experienced hands for the place you call home.
            </p>
            <div class="hero-actions">
              <a class="button button-lime" href="#contact">
                Get a Free Estimate <Icon name="diagonal" size={20} />
              </a>
              <a class="button button-outline" href="#services">
                Explore Tree Services <Icon name="arrow" size={20} />
              </a>
            </div>
          </div>
          <div class="hero-bottom">
            <span>
              <span class="status-dot"></span> 24/7 EMERGENCY & STORM DAMAGE
              SERVICE
            </span>
            <a href="#about" class="scroll-cue">
              Meet Your Local Tree Crew{' '}
              <span>
                <Icon name="arrow" size={18} />
              </span>
            </a>
          </div>
        </div>
      </section>
      <div class="trust-strip">
        <div class="container trust-inner">
          <div>
            <Icon name="shield" size={29} />
            <span>
              Licensed & Insured<small>Peace of mind comes standard.</small>
            </span>
          </div>
          <div>
            <Icon name="leaf" size={29} />
            <span>
              Free, Personal Estimates
              <small>Clear plans for your trees and property.</small>
            </span>
          </div>
          <div>
            <Icon name="home" size={29} />
            <span>
              Serving Michiana Since 2000
              <small>Local Roots. Experienced crews.</small>
            </span>
          </div>
        </div>
      </div>
      <TreeServices />
      <section class="section about" id="about" aria-labelledby="about-title">
        <div class="container about-grid">
          <div class="about-visual reveal">
            <img
              src="/images/abrajan-crew.webp"
              width="800"
              height="553"
              alt="The Abrajan Tree & Complete Landscaping Service team"
              loading="lazy"
            />
            <div class="photo-caption">
              <span class="status-dot"></span> YOUR LOCAL ABRAJAN TEAM
            </div>
            <div class="about-note">
              <Icon name="leaf" size={37} />
              <span>
                Serving Michiana.
                <br />
                <strong>Since 2000.</strong>
              </span>
            </div>
          </div>
          <div class="about-copy reveal">
            <p class="eyebrow">
              <span class="eyebrow-line"></span> A LITTLE ABOUT ABRAJAN
            </p>
            <h2 id="about-title">
              Local Roots.
              <br />
              Experienced Hands.
            </h2>
            <p class="section-lead">
              Tree work is personal when it’s your home underneath it.
            </p>
            <p>
              We’ve been serving Michiana since 2000, helping homeowners and
              businesses care for their trees and the property around them. From
              planned removals to storm damage, tree work is at the heart of
              what we do.
            </p>
            <p>
              We listen to what you need, talk through the work, and bring an
              experienced crew. And when your landscape needs attention, you
              already know a team who can help.
            </p>
            <div class="about-checks">
              <span>
                <Icon name="check" size={18} /> Experienced, Dedicated Crews
              </span>
              <span>
                <Icon name="check" size={18} /> Care That Fits Your Property
              </span>
            </div>
            <a class="text-link" href="#contact">
              Let’s Talk About Your Trees <Icon name="diagonal" size={22} />
            </a>
          </div>
        </div>
      </section>
      <section
        class="seasonal"
        id="property-care"
        aria-labelledby="seasonal-title"
      >
        <SectionContours tone="dark" />
        <div class="container seasonal-grid">
          <div class="seasonal-intro reveal">
            <p class="eyebrow light">
              <span class="eyebrow-line"></span> MORE CARE FOR YOUR PROPERTY
            </p>
            <h2 id="seasonal-title">
              Beyond the Trees.
              <br />
              <span>The Whole Property.</span>
            </h2>
            <p>
              Tree work comes first. Landscaping, land clearing, and ongoing
              property care bring everything else together—with the same local
              team you already know.
            </p>
            <a
              class="button button-lime"
              href="#contact"
              data-service="Landscaping & mulch"
            >
              Plan Your Property Care <Icon name="diagonal" size={20} />
            </a>
          </div>
          <div class="season-list reveal">
            <div>
              <span class="season-icon">
                <Icon name="leaf" size={27} />
              </span>
              <div>
                <h3>Land Clearing</h3>
                <p>Open up space and clear overgrowth for a fresh start.</p>
              </div>
              <span class="season-label">CLEAR</span>
            </div>
            <div>
              <span class="season-icon">
                <Icon name="sun" size={27} />
              </span>
              <div>
                <h3>Landscaping</h3>
                <p>Mulch, planting, stone, and thoughtful finishing touches.</p>
              </div>
              <span class="season-label">REFRESH</span>
            </div>
            <div>
              <span class="season-icon">
                <Icon name="tree" size={27} />
              </span>
              <div>
                <h3>Property Cleanups</h3>
                <p>Seasonal cleanups, leaf hauling, and gutter cleaning.</p>
              </div>
              <span class="season-label">RESTORE</span>
            </div>
            <div>
              <span class="season-icon">
                <Icon name="snow" size={27} />
              </span>
              <div>
                <h3>Year-Round Upkeep</h3>
                <p>
                  Lawn care through the growing season. Snow and ice care in
                  winter.
                </p>
              </div>
              <span class="season-label">MAINTAIN</span>
            </div>
          </div>
        </div>
      </section>
      <section class="section work" id="our-work" aria-labelledby="work-title">
        <div class="container">
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">
                <Icon name="leaf" size={18} /> A LITTLE BEFORE. A BEAUTIFUL
                AFTER.
              </p>
              <h2 id="work-title">
                Good Work.
                <br />
                <span>Right in Your Backyard.</span>
              </h2>
            </div>
            <p>
              A little attention can change everything.
              <br class="desktop-break" /> Slide to explore the before and
              after.
            </p>
          </div>
        </div>
        <BeforeAfterGallery />
      </section>
      <CustomerReviews />
      <section class="process-section" aria-labelledby="process-title">
        <SectionContours />
        <div class="container">
          <div class="process-intro reveal">
            <p class="eyebrow">
              <span class="eyebrow-line"></span> SIMPLE FROM THE START
            </p>
            <h2 id="process-title">
              Better Tree Care Starts
              <br />
              With a Conversation.
            </h2>
          </div>
          <div class="process-grid">
            <div class="reveal">
              <span class="step-number">01</span>
              <h3>Tell Us About Your Trees</h3>
              <p>
                A tree to remove, branches to trim, or a stump in the way. Start
                with what your property needs.
              </p>
            </div>
            <div class="reveal">
              <span class="step-number">02</span>
              <h3>Let’s Make a Plan</h3>
              <p>
                We’ll talk through your property’s needs and provide a free
                estimate for the work.
              </p>
            </div>
            <div class="reveal">
              <span class="step-number">03</span>
              <h3>Leave the Work to Us</h3>
              <p>
                Our crew takes care of the work, so you have more time for the
                good things outside.
              </p>
            </div>
          </div>
        </div>
      </section>
      <section class="section faq-section" aria-labelledby="faq-title">
        <div class="container faq-grid">
          <div class="reveal">
            <p class="eyebrow">
              <span class="eyebrow-line"></span> GOOD TO KNOW
            </p>
            <h2 id="faq-title">
              A Few Questions,
              <br />
              Answered.
            </h2>
            <p>
              Have something else in mind?
              <br />
              <a class="text-link" href="#contact">
                Let’s Talk About Your Project <Icon name="diagonal" size={20} />
              </a>
            </p>
          </div>
          <div class="faq-list reveal">
            {faqs.map((faq, index) => (
              <details name="faq" open={index === 0}>
                <summary>
                  {faq.question}
                  <Icon name="plus" size={20} />
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
      <ServiceArea />
      <section
        class="contact-section"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="container contact-grid">
          <div class="contact-copy reveal">
            <p class="eyebrow light">
              <span class="eyebrow-line"></span> LET’S TALK TREES
            </p>
            <h2 id="contact-title">
              Your Trees.
              <br />
              Our Next Project.
            </h2>
            <p>
              Tell us what needs attention, where you’re located, and what you
              have in mind. We’ll start with a free estimate.
            </p>
            <div class="contact-location">
              <Icon name="pin" size={20} /> Serving homes & businesses
              throughout Michiana.
            </div>
          </div>
          <form
            class="estimate-form reveal"
            action="/api/estimate"
            method="post"
            data-enabled={String(formEnabled)}
          >
            <h3>Let’s Talk About Your Project.</h3>
            <p class="form-intro">
              Tree work and property care, planned around you.
            </p>
            <div class="form-row">
              <div class="field">
                <label for="name">
                  Your Name <span>*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="First and last name"
                  autocomplete="name"
                  maxlength="100"
                  required
                />
              </div>
              <div class="field">
                <label for="phone">
                  Phone Number <span>*</span>
                </label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  placeholder="Your preferred contact number"
                  autocomplete="tel"
                  minlength="7"
                  maxlength="30"
                  required
                />
              </div>
            </div>
            <div class="field">
              <label for="email">
                Email Address <span>*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                maxlength="254"
                required
              />
            </div>
            <div class="field">
              <label for="service">
                How Can We Help? <span>*</span>
              </label>
              <select id="service" name="service" required>
                <option value="" disabled selected>
                  Select a Service
                </option>
                {estimateServiceOptions.map(({ value, label }) => (
                  <option value={value}>{label}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="message">
                A Little About Your Project <span>*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Tell us about your trees or property, and include your city or neighborhood."
                maxlength="3000"
                required
              ></textarea>
            </div>
            <div class="honey" aria-hidden="true">
              <label for="website">Leave this field empty</label>
              <input
                id="website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <button class="button button-green form-submit" type="submit">
              Request My Free Estimate <Icon name="diagonal" size={20} />
            </button>
            <p class="form-note">
              {formEnabled
                ? 'Your details are only used to respond to your request.'
                : 'Design preview — online requests are not enabled yet.'}
            </p>
            <p
              class="form-status"
              role="status"
              aria-live="polite"
              tabindex="-1"
              hidden
            ></p>
            <noscript>
              <p>
                This form requires JavaScript. Online requests are not available
                while the site is in preview mode.
              </p>
            </noscript>
          </form>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <a class="brand footer-brand" href="#top" aria-label="Abrajan home">
          <span class="brand-window">
            <img
              src="/images/abrajan-logo.webp"
              width="700"
              height="350"
              alt="Abrajan Tree & Complete Landscaping Service"
              loading="lazy"
            />
          </span>
        </a>
        <p>
          Tree Care With Local Roots.
          <br />
          <span>Serving Michiana Since 2000.</span>
        </p>
        <a class="back-top" href="#top">
          Back to Top{' '}
          <span>
            <Icon name="arrow" size={20} />
          </span>
        </a>
      </div>
      <div class="container footer-bottom">
        <span>
          © {new Date().getFullYear()} Abrajan Tree & Complete Landscaping
          Service.
        </span>
        <nav aria-label="Footer navigation">
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#our-work">Our Work</a>
          <a href="#contact">Contact</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/navigation';
      document
        .querySelectorAll<HTMLAnchorElement>('[data-service]')
        .forEach((link) =>
          link.addEventListener('click', () => {
            const select =
              document.querySelector<HTMLSelectElement>('#service');
            if (select) select.value = link.dataset.service || '';
          }),
        );
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll('.reveal').forEach((element) => {
          element.classList.add('will-reveal');
          observer.observe(element);
        });
      }
      const form = document.querySelector<HTMLFormElement>('.estimate-form');
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = form.querySelector<HTMLElement>('.form-status');
        const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
        if (!status || !submit) return;
        const announce = (message: string, success = false) => {
          status.textContent = message;
          status.classList.toggle('success', success);
          status.hidden = false;
          status.focus();
        };
        if (form.dataset.enabled !== 'true') {
          announce(
            'This preview does not send requests. Your information has not been sent or saved.',
          );
          return;
        }
        submit.disabled = true;
        submit.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/api/estimate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          if (!response.ok) {
            const result = await response.json().catch(() => ({}));
            throw new Error(
              result.error ||
                'We couldn’t send your request. Please try again later.',
            );
          }
          form.reset();
          announce(
            'Thank you! Your request has been sent. Our team will be in touch to talk about your project.',
            true,
          );
        } catch (error) {
          announce(
            error instanceof Error
              ? error.message
              : 'We couldn’t send your request. Please try again later.',
          );
        } finally {
          submit.disabled = false;
          submit.removeAttribute('aria-busy');
        }
      });
    </script>
  </body>
</html>
