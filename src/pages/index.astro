---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SectionContours from '../components/SectionContours.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import MobileNavigation from '../components/MobileNavigation.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import ServiceArea from '../components/ServiceArea.astro';

const formEnabled = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true';
const services = [
  {
    number: '01',
    title: 'Tree care & removal',
    image: 'tree-care.webp',
    alt: 'Abrajan crew member performing tree work',
    icon: 'tree',
    text: 'From careful trimming to tree and stump removal, give your property the room it needs to thrive.',
    items: 'Tree trimming · Tree removal · Stump removal',
    value: 'Tree care & removal',
  },
  {
    number: '02',
    title: 'Complete landscaping',
    image: 'garden-beds.webp',
    alt: 'Curved mulch and stone beds around established trees, landscaped by Abrajan',
    icon: 'leaf',
    text: 'Fresh mulch, thoughtful planting, and clean edges. It’s the details that make a yard feel like home.',
    items: 'Sod & mulch · Gravel & stone · Hedge pruning',
    value: 'Landscaping & mulch',
  },
  {
    number: '03',
    title: 'Lawn & property care',
    image: 'lawn-care.webp',
    alt: 'A residential lawn and garden beds maintained by Abrajan',
    icon: 'sun',
    text: 'Keep your outdoor space looking its best with regular attention and a dependable crew.',
    items: 'Mowing & edging · De-thatching · Grub control',
    value: 'Lawn & property care',
  },
];
const faqs = [
  {
    question: 'Can I get a free estimate?',
    answer:
      'Yes. Call 574-292-2913 or 574-292-2100 and tell us about your property and the work you have in mind. We’ll discuss the next step for your free estimate.',
  },
  {
    question: 'Do you work with homes and businesses?',
    answer:
      'We provide residential and commercial landscaping, tree services, and lawn care throughout the Michiana area. Get in touch to confirm service for your location.',
  },
  {
    question: 'Are you licensed and insured?',
    answer:
      'Yes. Abrajan Tree & Complete Landscaping Service is licensed and insured.',
  },
  {
    question: 'Can you help during the fall and winter?',
    answer:
      'Absolutely. Our seasonal services include spring and fall cleanups, leaf hauling, gutter cleaning, snow plowing and shoveling, and salting sidewalks and parking lots.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123c2c" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Abrajan Tree & Complete Landscaping Service brings tree care, lawn maintenance, landscaping, and seasonal property care to Michiana. Licensed and insured. Free estimates."
    />
    <meta
      property="og:title"
      content="Abrajan — Beautiful yards. Healthy trees."
    />
    <meta
      property="og:description"
      content="Local people. Complete care. Tree and landscaping services for homes and businesses in Michiana."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/hero-landscape.webp" />
    <title>Abrajan | Tree Care & Complete Landscaping in Michiana</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/images/hero-landscape.webp" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="topbar">
      <div class="container topbar-inner">
        <span>
          <Icon name="pin" size={15} /> Proudly serving the Michiana area
        </span>
        <div>
          <span class="topbar-assurance">
            <Icon name="shield" size={15} /> Licensed & insured
          </span>
          <a href="tel:+15742922913">
            <Icon name="phone" size={14} /> 574-292-2913
          </a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container nav-inner">
        <a
          class="brand"
          href="#top"
          aria-label="Abrajan Tree & Complete Landscaping Service home"
        >
          <span class="brand-window">
            <img
              src="/images/abrajan-logo.webp"
              width="700"
              height="350"
              alt="Abrajan Tree & Complete Landscaping Service"
            />
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a
            href="#top"
            class="active"
            data-nav-section="top"
            aria-current="location"
          >
            Home
          </a>
          <a href="#about" data-nav-section="about">
            About us
          </a>
          <a href="#services" data-nav-section="services">
            Services
          </a>
          <a href="#our-work" data-nav-section="our-work">
            Our work
          </a>
          <a href="#reviews" data-nav-section="reviews">
            Reviews
          </a>
          <a href="#contact" data-nav-section="contact">
            Contact
          </a>
        </nav>
        <a class="button button-lime nav-cta" href="#contact">
          Get a free estimate <Icon name="diagonal" size={19} />
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-haspopup="dialog"
        >
          <span class="menu-label" aria-hidden="true">
            Menu
          </span>
          <span class="menu-lines" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </header>
    <MobileNavigation />
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src="/images/hero-landscape.webp"
          alt="Illustrative aerial view of a lush garden, green lawn, and winding path"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <div class="hero-shade"></div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow light">
              <span class="eyebrow-line"></span> TREE CARE & COMPLETE
              LANDSCAPING
            </p>
            <h1 id="hero-title">
              Beautiful yards.
              <br />
              Healthy trees.
              <br />
              <span>More life outside.</span>
            </h1>
            <p class="hero-description">
              From the tallest tree to the smallest detail, we care for your
              outdoor space—so you can simply enjoy it.
            </p>
            <div class="hero-actions">
              <a class="button button-lime" href="#contact">
                Get a free estimate <Icon name="diagonal" size={20} />
              </a>
              <a class="button button-outline" href="#services">
                Explore our services <Icon name="arrow" size={20} />
              </a>
            </div>
          </div>
          <div class="hero-bottom">
            <span>
              <span class="status-dot"></span> LOCAL PEOPLE. COMPLETE CARE.
            </span>
            <a href="#about" class="scroll-cue">
              A better yard starts here{' '}
              <span>
                <Icon name="arrow" size={18} />
              </span>
            </a>
          </div>
        </div>
      </section>
      <div class="trust-strip">
        <div class="container trust-inner">
          <div>
            <Icon name="shield" size={29} />
            <span>
              Licensed & insured<small>Peace of mind comes standard.</small>
            </span>
          </div>
          <div>
            <Icon name="leaf" size={29} />
            <span>
              Free, personal estimates
              <small>Let’s find the right fit for your yard.</small>
            </span>
          </div>
          <div>
            <Icon name="home" size={29} />
            <span>
              Homes & businesses<small>Complete care, all year long.</small>
            </span>
          </div>
        </div>
      </div>
      <section class="section about" id="about" aria-labelledby="about-title">
        <div class="container about-grid">
          <div class="about-visual reveal">
            <img
              src="/images/abrajan-crew.webp"
              width="800"
              height="553"
              alt="The Abrajan Tree & Complete Landscaping Service team"
              loading="lazy"
            />
            <div class="photo-caption">
              <span class="status-dot"></span> YOUR LOCAL ABRAJAN TEAM
            </div>
            <div class="about-note">
              <Icon name="leaf" size={37} />
              <span>
                Rooted in care.
                <br />
                <strong>Growing together.</strong>
              </span>
            </div>
          </div>
          <div class="about-copy reveal">
            <p class="eyebrow">
              <span class="eyebrow-line"></span> A LITTLE ABOUT ABRAJAN
            </p>
            <h2 id="about-title">
              Local roots.
              <br />
              Beautiful results.
            </h2>
            <p class="section-lead">
              Your yard is more than a piece of land. It’s part of your home.
            </p>
            <p>
              At Abrajan, we bring personal attention and hardworking hands to
              residential and commercial properties across Michiana. Our goal is
              simple: make your yard beautiful, and make caring for it easier.
            </p>
            <p>
              We work with you one on one, listen to your vision, and put our
              experienced crews to work on the details that matter to you.
            </p>
            <div class="about-checks">
              <span>
                <Icon name="check" size={18} /> Experienced, dedicated crews
              </span>
              <span>
                <Icon name="check" size={18} /> Care that fits your property
              </span>
            </div>
            <a class="text-link" href="#contact">
              Let’s talk about your yard <Icon name="diagonal" size={22} />
            </a>
          </div>
        </div>
      </section>
      <section
        class="section services"
        id="services"
        aria-labelledby="services-title"
      >
        <div class="container">
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">
                <span class="eyebrow-line"></span> WHAT WE DO
              </p>
              <h2 id="services-title">
                Everything your
                <br />
                outdoors needs.
              </h2>
            </div>
            <p>
              One team for your trees, lawn, and landscape.
              <br class="desktop-break" /> A little less on your to-do list.
            </p>
          </div>
          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card reveal">
                <a
                  class="service-image"
                  href="#contact"
                  data-service={service.value}
                  aria-label={`Request an estimate for ${service.title}`}
                >
                  <img
                    src={`/images/${service.image}`}
                    alt={service.alt}
                    width="650"
                    height="520"
                    loading="lazy"
                  />
                  <span class="service-number">{service.number}</span>
                  <span class="service-icon">
                    <Icon name={service.icon} size={26} />
                  </span>
                </a>
                <div class="service-body">
                  <h3>
                    <a href="#contact" data-service={service.value}>
                      {service.title}
                    </a>
                  </h3>
                  <p>{service.text}</p>
                  <small>{service.items}</small>
                  <a
                    class="text-link"
                    href="#contact"
                    data-service={service.value}
                  >
                    Let’s get started <Icon name="diagonal" size={20} />
                  </a>
                </div>
              </article>
            ))}
          </div>
          <div class="service-extra">
            <span>AND THE FINISHING TOUCHES</span>
            <p>
              Gutter cleaning <i>·</i> Topsoil & sand <i>·</i> Leaf hauling{' '}
              <i>·</i> Spring & fall cleanups
            </p>
          </div>
        </div>
      </section>
      <section class="seasonal" aria-labelledby="seasonal-title">
        <SectionContours tone="dark" />
        <div class="container seasonal-grid">
          <div class="seasonal-intro reveal">
            <p class="eyebrow light">
              <span class="eyebrow-line"></span> HERE THROUGH EVERY SEASON
            </p>
            <h2 id="seasonal-title">
              The seasons change.
              <br />
              <span>Our care stays.</span>
            </h2>
            <p>
              From the first spring cleanup to the last snowfall, we help keep
              your property looking good and ready for whatever comes next.
            </p>
            <a
              class="button button-lime"
              href="#contact"
              data-service="Seasonal cleanup"
            >
              Plan your seasonal care <Icon name="diagonal" size={20} />
            </a>
          </div>
          <div class="season-list reveal">
            <div>
              <span class="season-icon">
                <Icon name="leaf" size={27} />
              </span>
              <div>
                <h3>A fresh start</h3>
                <p>Spring cleanup, fresh mulch, and de-thatching.</p>
              </div>
              <span class="season-label">SPRING</span>
            </div>
            <div>
              <span class="season-icon">
                <Icon name="sun" size={27} />
              </span>
              <div>
                <h3>Room to enjoy</h3>
                <p>Weekly mowing, edging, and hedge trimming.</p>
              </div>
              <span class="season-label">SUMMER</span>
            </div>
            <div>
              <span class="season-icon">
                <Icon name="tree" size={27} />
              </span>
              <div>
                <h3>A clean finish</h3>
                <p>Fall cleanup, leaf hauling, and gutter cleaning.</p>
              </div>
              <span class="season-label">FALL</span>
            </div>
            <div>
              <span class="season-icon">
                <Icon name="snow" size={27} />
              </span>
              <div>
                <h3>Clear the way</h3>
                <p>Snow plowing, shoveling, and salting.</p>
              </div>
              <span class="season-label">WINTER</span>
            </div>
          </div>
        </div>
      </section>
      <section class="section work" id="our-work" aria-labelledby="work-title">
        <div class="container">
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">
                <Icon name="leaf" size={18} /> A LITTLE BEFORE. A BEAUTIFUL
                AFTER.
              </p>
              <h2 id="work-title">
                Good work.
                <br />
                <span>Right in your backyard.</span>
              </h2>
            </div>
            <p>
              A little attention can change everything.
              <br class="desktop-break" /> Slide to explore the before and
              after.
            </p>
          </div>
        </div>
        <BeforeAfterGallery />
      </section>
      <CustomerReviews />
      <section class="process-section" aria-labelledby="process-title">
        <SectionContours />
        <div class="container">
          <div class="process-intro reveal">
            <p class="eyebrow">
              <span class="eyebrow-line"></span> SIMPLE FROM THE START
            </p>
            <h2 id="process-title">
              Your better yard starts
              <br />
              with a conversation.
            </h2>
          </div>
          <div class="process-grid">
            <div class="reveal">
              <span class="step-number">01</span>
              <h3>Tell us what you have in mind</h3>
              <p>
                A fresh start, regular upkeep, or a tree that needs attention.
                We’re here to listen.
              </p>
            </div>
            <div class="reveal">
              <span class="step-number">02</span>
              <h3>Let’s make a plan</h3>
              <p>
                We’ll talk through your property’s needs and provide a free
                estimate for the work.
              </p>
            </div>
            <div class="reveal">
              <span class="step-number">03</span>
              <h3>Enjoy your outdoor space</h3>
              <p>
                Our crew takes care of the work, so you have more time for the
                good things outside.
              </p>
            </div>
          </div>
        </div>
      </section>
      <section class="section faq-section" aria-labelledby="faq-title">
        <div class="container faq-grid">
          <div class="reveal">
            <p class="eyebrow">
              <span class="eyebrow-line"></span> GOOD TO KNOW
            </p>
            <h2 id="faq-title">
              A few questions,
              <br />
              answered.
            </h2>
            <p>
              Have something else in mind?
              <br />
              <a class="text-link" href="tel:+15742922913">
                Give us a call <Icon name="diagonal" size={20} />
              </a>
            </p>
          </div>
          <div class="faq-list reveal">
            {faqs.map((faq, index) => (
              <details name="faq" open={index === 0}>
                <summary>
                  {faq.question}
                  <Icon name="plus" size={20} />
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
      <ServiceArea />
      <section
        class="contact-section"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="container contact-grid">
          <div class="contact-copy reveal">
            <p class="eyebrow light">
              <span class="eyebrow-line"></span> LET’S MAKE SOMETHING BEAUTIFUL
            </p>
            <h2 id="contact-title">
              A better yard
              <br />
              is one hello away.
            </h2>
            <p>
              Tell us a little about your property and what you have in mind.
              We’d love to help bring it to life.
            </p>
            <a href="tel:+15742922913" class="contact-phone">
              <span>
                <Icon name="phone" size={25} />
              </span>
              <div>
                <small>CALL FOR A FREE ESTIMATE</small>
                <strong>574-292-2913</strong>
              </div>
            </a>
            <a href="tel:+15742922100" class="alternate-phone">
              You can also reach us at <strong>574-292-2100</strong>{' '}
              <Icon name="diagonal" size={16} />
            </a>
            <div class="contact-location">
              <Icon name="pin" size={20} /> Serving homes & businesses
              throughout Michiana.
            </div>
          </div>
          <form
            class="estimate-form reveal"
            action="/api/estimate"
            method="post"
            data-enabled={String(formEnabled)}
          >
            <h3>Let’s talk about your project.</h3>
            <p class="form-intro">A beautiful outdoor space starts here.</p>
            <div class="form-row">
              <div class="field">
                <label for="name">
                  Your name <span>*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="First and last name"
                  autocomplete="name"
                  maxlength="100"
                  required
                />
              </div>
              <div class="field">
                <label for="phone">
                  Phone number <span>*</span>
                </label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  placeholder="(574) 000-0000"
                  autocomplete="tel"
                  minlength="7"
                  maxlength="30"
                  required
                />
              </div>
            </div>
            <div class="field">
              <label for="email">
                Email address <span>*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                maxlength="254"
                required
              />
            </div>
            <div class="field">
              <label for="service">
                How can we help? <span>*</span>
              </label>
              <select id="service" name="service" required>
                <option value="" disabled selected>
                  Select a service
                </option>
                <option>Tree care & removal</option>
                <option>Landscaping & mulch</option>
                <option>Lawn & property care</option>
                <option>Seasonal cleanup</option>
                <option>Snow & ice management</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="field">
              <label for="message">
                A little about your project <span>*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="What would you love to do with your outdoor space? Include your city or neighborhood."
                maxlength="3000"
                required
              ></textarea>
            </div>
            <div class="honey" aria-hidden="true">
              <label for="website">Leave this field empty</label>
              <input
                id="website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <button class="button button-green form-submit" type="submit">
              Request my free estimate <Icon name="diagonal" size={20} />
            </button>
            <p class="form-note">
              {formEnabled
                ? 'Your details are only used to respond to your request.'
                : 'Online requests are coming soon. For now, call us for your free estimate.'}
            </p>
            <p
              class="form-status"
              role="status"
              aria-live="polite"
              tabindex="-1"
              hidden
            ></p>
            <noscript>
              <p>
                Please call <a href="tel:+15742922913">574-292-2913</a> to
                request an estimate.
              </p>
            </noscript>
          </form>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <a class="brand footer-brand" href="#top" aria-label="Abrajan home">
          <span class="brand-window">
            <img
              src="/images/abrajan-logo.webp"
              width="700"
              height="350"
              alt="Abrajan Tree & Complete Landscaping Service"
              loading="lazy"
            />
          </span>
        </a>
        <p>
          Making your yard beautiful.
          <br />
          <span>One season at a time.</span>
        </p>
        <a class="back-top" href="#top">
          Back to top{' '}
          <span>
            <Icon name="arrow" size={20} />
          </span>
        </a>
      </div>
      <div class="container footer-bottom">
        <span>
          © {new Date().getFullYear()} Abrajan Tree & Complete Landscaping
          Service.
        </span>
        <nav aria-label="Footer navigation">
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#our-work">Our work</a>
          <a href="#contact">Contact</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/navigation';
      document
        .querySelectorAll<HTMLAnchorElement>('[data-service]')
        .forEach((link) =>
          link.addEventListener('click', () => {
            const select =
              document.querySelector<HTMLSelectElement>('#service');
            if (select) select.value = link.dataset.service || '';
          }),
        );
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll('.reveal').forEach((element) => {
          element.classList.add('will-reveal');
          observer.observe(element);
        });
      }
      const form = document.querySelector<HTMLFormElement>('.estimate-form');
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = form.querySelector<HTMLElement>('.form-status');
        const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
        if (!status || !submit) return;
        const announce = (message: string, success = false) => {
          status.textContent = message;
          status.classList.toggle('success', success);
          status.hidden = false;
          status.focus();
        };
        if (form.dataset.enabled !== 'true') {
          announce(
            'This preview does not send requests. Please call 574-292-2913 for your free estimate. Your information has not been sent or saved.',
          );
          return;
        }
        submit.disabled = true;
        submit.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/api/estimate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          if (!response.ok) {
            const result = await response.json().catch(() => ({}));
            throw new Error(
              result.error ||
                'We couldn’t send your request. Please try again or call 574-292-2913.',
            );
          }
          form.reset();
          announce(
            'Thank you! Your request has been sent. Our team will be in touch to talk about your project.',
            true,
          );
        } catch (error) {
          announce(
            error instanceof Error
              ? error.message
              : 'We couldn’t send your request. Please call 574-292-2913.',
          );
        } finally {
          submit.disabled = false;
          submit.removeAttribute('aria-busy');
        }
      });
    </script>
  </body>
</html>
