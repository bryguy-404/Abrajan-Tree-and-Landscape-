---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { workFilms, workPhotos } from '../data/work-gallery';
import { estimateHref, locationLabel } from '../data/business';
import '../styles/our-work.css';
const [photos, films] = await Promise.all([workPhotos(), workFilms()]);
const [feature, ...shorts] = films;
const filters = [
  { id: 'all', label: 'All Photos' },
  { id: 'tree', label: 'Tree Work' },
  { id: 'landscape', label: 'Landscape & Lawn' },
  { id: 'people', label: 'Our People' },
];
---

<SiteLayout
  title="Our Work | Tree Care & Landscaping Photos | Abrajan"
  description="See Abrajan at work. Explore real photos and short videos of our tree crew, equipment, and landscaping across Michiana."
  image={feature.image.src}
  imageSrcSet={feature.image.srcset}
  imageSizes={feature.image.sizes}
>
  <main id="main" class="work-page">
    <section
      class="work-intro"
      data-page-hero
      aria-labelledby="work-page-title"
    >
      <div class="container">
        <nav class="work-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Our Work</span>
        </nav>
        <div class="work-intro-heading">
          <div>
            <p class="eyebrow">
              <span class="eyebrow-line"></span> OUT HERE. EVERY DAY.
            </p>
            <h1 id="work-page-title">
              Our Work.
              <br />
              <span>Up Close.</span>
            </h1>
          </div>
          <div class="work-intro-copy">
            <p>
              The people. The equipment. The care that goes into it. A closer
              look at Abrajan, from the canopy to the cleanup.
            </p>
            <a class="text-link" href="#photo-gallery">
              Explore the Gallery <Icon name="arrow" size={20} />
            </a>
          </div>
        </div>
        <a
          class="work-feature film-link"
          href={feature.src}
          target="_blank"
          rel="noopener"
          data-media="video"
          data-group="films"
          data-title={feature.title}
          data-description={feature.description}
          data-poster={feature.image.src}
          aria-label={`Watch ${feature.title} 24-second video`}
          aria-haspopup="dialog"
          aria-controls="work-viewer"
        >
          <img
            {...feature.image}
            fetchpriority="high"
            style={`object-position:${feature.position}`}
          />
          <span class="feature-corner">ABRAJAN / IN THE FIELD</span>
          <span class="work-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26">
              <path d="m9 5 11 7-11 7Z" fill="currentColor" />
            </svg>
          </span>
          <span class="feature-caption">
            <span>
              <small>{feature.label}</small>
              <strong>{feature.title}</strong>
            </span>
            <span class="film-duration">
              Watch Film <span aria-hidden="true">↗</span>
              <small>{feature.duration}</small>
            </span>
          </span>
        </a>
        <div class="feature-footnote">
          <span>Real people. Real work. Right here in Michiana.</span>
          <a href="#crew-films">
            More From the Job Site <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <section
      class="work-gallery section"
      id="photo-gallery"
      aria-labelledby="gallery-title"
    >
      <div class="container">
        <div class="work-section-heading" data-work-reveal>
          <div>
            <p class="eyebrow">
              <span class="eyebrow-line"></span> FROM OUR CAMERA ROLL
            </p>
            <h2 id="gallery-title">
              The Work.
              <br />
              <span>The People Behind It.</span>
            </h2>
          </div>
          <p>
            Big tree work, cared-for yards, and the crew that brings it all
            together. Select a photo to take a closer look.
          </p>
        </div>
        <div
          class="work-filters"
          data-work-filters
          hidden
          role="group"
          aria-label="Filter work photos"
        >
          {filters.map((filter) => (
            <button
              type="button"
              data-filter={filter.id}
              aria-pressed={filter.id === 'all'}
            >
              {filter.label}
              <span>
                {filter.id === 'all'
                  ? photos.length
                  : photos.filter((photo) => photo.category === filter.id)
                      .length}
              </span>
            </button>
          ))}
        </div>
        <p class="sr-only" data-filter-status aria-live="polite"></p>
        <div class="work-photo-grid">
          {photos.map((photo) => (
            <figure class="work-photo" data-category={photo.category}>
              <a
                href={photo.image.src}
                target="_blank"
                rel="noopener"
                class:list={['work-photo-link', photo.shape]}
                data-media="image"
                data-group="photos"
                data-title={photo.title}
                data-description={photo.image.alt}
                aria-label={`Enlarge ${photo.title}`}
                aria-haspopup="dialog"
                aria-controls="work-viewer"
              >
                <img
                  {...photo.image}
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${photo.position}`}
                />
                <span class="work-enlarge" aria-hidden="true">
                  <Icon name="plus" size={22} />
                </span>
              </a>
              <figcaption>
                <span>{photo.label}</span>
                <h3>{photo.title}</h3>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="work-gallery-bottom">
          <span>A few moments from the work we do.</span>
          <a href="/services/tree-services/" class="text-link">
            Explore Our Tree Services <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="work-films" id="crew-films" aria-labelledby="films-title">
      <div class="container">
        <div class="work-section-heading" data-work-reveal>
          <div>
            <p class="eyebrow light">
              <span class="eyebrow-line"></span> A DAY WITH THE CREW
            </p>
            <h2 id="films-title">
              Some Things Are
              <br />
              <span>Better Seen in Motion.</span>
            </h2>
          </div>
          <p>
            A view from the ground. A look up into the canopy. Short moments
            from real Abrajan workdays.
          </p>
        </div>
        <div class="work-film-grid" data-work-reveal>
          {shorts.map((film) => (
            <a
              class:list={['work-film-card', 'film-link', `film-${film.id}`]}
              href={film.src}
              target="_blank"
              rel="noopener"
              data-media="video"
              data-group="films"
              data-title={film.title}
              data-description={film.description}
              data-poster={film.image.src}
              aria-label={`Watch ${film.title}, ${film.duration} video`}
              aria-haspopup="dialog"
              aria-controls="work-viewer"
            >
              <img
                {...film.image}
                loading="lazy"
                decoding="async"
                style={`object-position:${film.position}`}
              />
              <span class="film-time">{film.duration}</span>
              <span class="work-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="23" height="23">
                  <path d="m9 5 11 7-11 7Z" fill="currentColor" />
                </svg>
              </span>
              <span class="film-card-caption">
                <small>{film.label}</small>
                <strong>{film.title}</strong>
              </span>
            </a>
          ))}
        </div>
        <div class="film-note">
          <span>
            Select a film to watch. Clips are presented without audio.
          </span>
          <a href="/about/">
            Meet the People Behind the Work <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </section>

    <section
      class="work-next section"
      id="service-estimate"
      aria-labelledby="work-next-title"
    >
      <div class="container" data-work-reveal>
        <div>
          <p class="eyebrow">
            <span class="eyebrow-line"></span> YOUR PROPERTY. OUR NEXT PROJECT.
          </p>
          <h2 id="work-next-title">
            Let’s Talk About
            <br />
            <span>What You Have in Mind.</span>
          </h2>
          <p>
            Tree work or a fresh start for your yard—we’d love to hear about it.
            Serving {locationLabel}, and surrounding Michiana communities.
          </p>
          <div class="work-next-links">
            <a href="/services/tree-removal/">
              Tree Removal <Icon name="diagonal" size={15} />
            </a>
            <a href="/services/landscaping/">
              Landscaping <Icon name="diagonal" size={15} />
            </a>
          </div>
        </div>
        <a href={estimateHref()} class="button button-lime">
          Get a Free Estimate <Icon name="diagonal" size={21} />
        </a>
      </div>
    </section>

    <dialog
      id="work-viewer"
      class="work-viewer"
      aria-labelledby="viewer-title"
      aria-describedby="viewer-description"
    >
      <div class="work-viewer-shell">
        <div class="viewer-heading">
          <span data-viewer-kind></span>
          <button
            type="button"
            data-viewer-close
            aria-label="Close media viewer"
            autofocus
          >
            <Icon name="close" size={24} />
          </button>
        </div>
        <div class="viewer-stage">
          <p data-media-loading hidden role="status">
            Loading…
          </p>
          <img data-viewer-image alt="" hidden />
          <video
            data-viewer-video
            controls
            playsinline
            preload="none"
            hidden
          ></video>
          <p data-media-error hidden role="status">
            This media couldn’t load.{' '}
            <a data-media-direct target="_blank" rel="noopener">
              Open the original file
            </a>
            .
          </p>
        </div>
        <div class="viewer-footer">
          <div>
            <h2 id="viewer-title"></h2>
            <p id="viewer-description"></p>
          </div>
          <div class="viewer-navigation">
            <button type="button" data-viewer-prev aria-label="Previous item">
              <span aria-hidden="true">←</span>
            </button>
            <span data-viewer-count aria-live="polite"></span>
            <button type="button" data-viewer-next aria-label="Next item">
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
      </div>
    </dialog>
  </main>
</SiteLayout>

<script>
  import '../scripts/work-gallery';
</script>
