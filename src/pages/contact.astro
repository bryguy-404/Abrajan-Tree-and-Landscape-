---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import EstimateForm from '../components/EstimateForm.astro';
import ServiceArea from '../components/ServiceArea.astro';
import { locationLabel } from '../data/business';
import '../styles/interior.css';
---

<SiteLayout
  preloadImage={false}
  title={`Contact Abrajan | Free Tree Service Estimates in ${locationLabel}`}
  description={`Tell Abrajan about your tree removal, trimming, stump grinding, or property care project in ${locationLabel} and surrounding Michiana communities.`}
>
  <main id="main" class="interior-page contact-page">
    <section
      class="interior-hero contact-hero"
      data-page-hero
      aria-labelledby="page-title"
    >
      <div class="container">
        <nav class="interior-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Contact</span>
        </nav>
        <div class="contact-page-grid">
          <div class="interior-intro">
            <p class="eyebrow">
              <span class="eyebrow-line"></span> A GOOD PLACE TO START
            </p>
            <h1 id="page-title">
              Let’s Talk
              <br />
              <span>About Your Trees.</span>
            </h1>
            <p class="interior-lead">
              A tree that needs attention.
              <br />A property you have plans for.
              <br />
              We’d like to hear about it.
            </p>
            <p>
              Tell us what you need and where you’re located. Tree work or a
              fresh start for your landscape—we’ll begin with a free estimate.
            </p>
            <a
              class="button button-green contact-mobile-start"
              href="#estimate"
            >
              Start My Free Estimate <Icon name="diagonal" size={19} />
            </a>
            <div class="contact-details">
              <div>
                <Icon name="pin" size={23} />
                <span>
                  <strong>{locationLabel}</strong>
                  <small>Serving the surrounding Michiana area</small>
                </span>
              </div>
              <div>
                <Icon name="shield" size={23} />
                <span>
                  <strong>Licensed & Insured</strong>
                  <small>Serving homes and businesses since 2000</small>
                </span>
              </div>
            </div>
            <div class="contact-next">
              <p class="eyebrow">HELP US GET TO KNOW YOUR PROJECT</p>
              <ol>
                <li>
                  <span>01</span> Choose the service you have in mind.
                </li>
                <li>
                  <span>02</span> Include your city and a few project details.
                </li>
                <li>
                  <span>03</span> Let us know the best way to reach you.
                </li>
              </ol>
            </div>
          </div>
          <div class="contact-form-wrap" id="estimate">
            <EstimateForm headingLevel="h2" />
          </div>
        </div>
      </div>
    </section>
    <section
      class="contact-emergency"
      aria-labelledby="emergency-contact-title"
    >
      <div class="container">
        <Icon name="storm" size={33} />
        <div>
          <h2 id="emergency-contact-title">Storm Damage or a Fallen Tree?</h2>
          <p>
            Abrajan offers 24/7 emergency tree service. This online estimate
            form is for project inquiries and is not an emergency dispatch
            service.
          </p>
        </div>
        <a class="text-link" href="/services/tree-services/#emergency">
          Emergency Tree Services <Icon name="arrow" size={19} />
        </a>
      </div>
    </section>
    <ServiceArea />
  </main>
</SiteLayout>
