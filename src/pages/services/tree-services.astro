---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import ServiceQuestions from '../../components/ServiceQuestions.astro';
import ServiceCallout from '../../components/ServiceCallout.astro';
import Icon from '../../components/Icon.astro';
import { serviceImage } from '../../data/service-images';
const canopyImage = await serviceImage(
  'canopy',
  1600,
  '(max-width: 760px) 100vw, (max-width: 1352px) 90vw, 1240px',
);
import {
  locationLabel,
  primaryLocation,
  serviceCommunities,
} from '../../data/business';
import '../../styles/services.css';

const offerings = [
  {
    id: 'removal',
    title: 'Tree Removal',
    icon: 'tree',
    number: '01',
    text: 'A tree can become too damaged, too crowded, or too close for comfort. We’ll talk through the situation and plan the removal around the tree, the access, and the property around it.',
    href: '/services/tree-removal/',
    link: 'Explore Tree Removal',
  },
  {
    id: 'storm-damage',
    title: 'Emergency & Storm Damage',
    icon: 'storm',
    number: '24/7',
    text: 'Fallen trees and broken limbs can turn a familiar yard into an urgent problem. Our emergency tree service focuses on the tree work needed after unexpected damage.',
    href: '/services/emergency-tree-service/',
    link: 'About Emergency Tree Service',
  },
  {
    id: 'tree-trimming',
    title: 'Tree Trimming',
    icon: 'prune',
    number: '03',
    text: 'Give growing trees the room and attention they need. From overextended branches to clearance around your property, we’ll discuss what needs trimming and the result you have in mind.',
    href: '/services/tree-trimming/',
    link: 'Plan Your Tree Trimming',
  },
  {
    id: 'stump-grinding',
    title: 'Stump Grinding',
    icon: 'stump',
    number: '04',
    text: 'An old stump doesn’t have to be part of your next chapter. Grinding can help reclaim space for a more usable yard. Ask us about access, the remaining material, and your plans for the area.',
    href: '/services/stump-grinding/',
    link: 'Talk About Stump Grinding',
  },
];
const questions = [
  {
    question: 'Which tree services do you offer?',
    answer:
      'Our tree work includes tree removal, tree trimming, stump grinding, and 24/7 emergency service for storm damage, fallen trees, and broken limbs. Tell us what is happening on your property so we can discuss the right next step.',
  },
  {
    question: 'Do I need trimming or removal?',
    answer:
      'That depends on the tree and your concerns. Let us know what you’ve noticed, what is nearby, and what you want to change. We can discuss the work with you before you decide on a plan.',
  },
  {
    question: 'Can I request more than one service?',
    answer:
      'Yes. If you need a tree removed, another trimmed, and an old stump addressed, include those details in your request. We’ll talk through the scope together so you know what the estimate covers.',
  },
  {
    question: `Do you serve areas outside ${primaryLocation.city}?`,
    answer: `Yes. We also serve ${serviceCommunities.filter((city) => city !== primaryLocation.city).join(', ')}, and surrounding Michiana communities. Include your project location when you request an estimate so we can confirm service at your property.`,
  },
  {
    question: 'Are estimates free?',
    answer:
      'Yes. Abrajan offers free estimates. Share a little about your trees, your property, and the work you have in mind to get the conversation started.',
  },
];
---

<SiteLayout
  title={`Tree Services in ${locationLabel} | Abrajan`}
  description={`Tree removal, trimming, stump grinding, and 24/7 storm damage tree service in ${locationLabel}. Licensed and insured. Serving Michiana since 2000.`}
  image={canopyImage.src}
  imageSrcSet={canopyImage.srcset}
  imageSizes={canopyImage.sizes}
>
  <main id="main" class="care-overview-page">
    <ServiceHero image={canopyImage} />
    <section class="section" id="tree-care" aria-labelledby="tree-care-title">
      <div class="container">
        <div class="service-intro-row reveal">
          <div>
            <p class="eyebrow">
              <span class="eyebrow-line"></span> THE RIGHT CARE FOR WHAT’S NEXT
            </p>
            <h2 id="tree-care-title">
              What Do Your
              <br />
              <span>Trees Need?</span>
            </h2>
          </div>
          <p>
            A little more clearance. A storm-damaged tree. A fresh start for the
            yard. Whatever brings us to your property, we start by understanding
            what you need.
          </p>
        </div>
        <div class="care-directory">
          <figure class="care-directory-photo reveal">
            <img
              src="/images/tree-care.webp"
              width="900"
              height="1471"
              loading="lazy"
              alt="An Abrajan tree worker climbing among branches on a residential property"
            />
            <figcaption>
              <span>YOUR ABRAJAN TREE CREW</span>
              <p>
                Hands-On Care.
                <br />
                Local Roots.
              </p>
            </figcaption>
          </figure>
          <div class="care-directory-list">
            {offerings.map((item) => (
              <article
                class="care-option reveal"
                id={item.id}
                aria-labelledby={`${item.id}-title`}
              >
                <span class="care-option-number">{item.number}</span>
                <div>
                  <h3 id={`${item.id}-title`}>{item.title}</h3>
                  <p>{item.text}</p>
                  <a class="text-link" href={item.href}>
                    {item.link}
                    <Icon name="diagonal" size={18} />
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section
      class="service-emergency"
      id="emergency"
      aria-labelledby="emergency-title"
    >
      <div class="container service-emergency-inner">
        <div class="emergency-badge" aria-hidden="true">
          <Icon name="storm" size={32} />
          <span>24/7</span>
        </div>
        <div>
          <p class="eyebrow">WHEN THE UNEXPECTED HAPPENS</p>
          <h2 id="emergency-title">Storms Don’t Keep Business Hours.</h2>
          <p>
            Abrajan offers 24/7 emergency tree service for fallen trees, storm
            damage, and broken limbs. The work starts with understanding the
            damage, the surroundings, and what needs attention.
          </p>
          <p class="emergency-note">
            Online estimate requests are not an emergency dispatch service.
          </p>
        </div>
      </div>
    </section>
    <section class="section" aria-labelledby="property-title">
      <div class="container service-story">
        <figure class="service-story-photo reveal">
          <img
            src="/images/garden-beds.webp"
            width="1024"
            height="768"
            loading="lazy"
            alt="A residential landscape and garden bed from the Abrajan project gallery"
          />
          <figcaption>CARE FOR THE REST OF YOUR OUTDOOR SPACE.</figcaption>
        </figure>
        <div class="service-story-copy reveal">
          <p class="eyebrow">
            <span class="eyebrow-line"></span> BEYOND THE TREES
          </p>
          <h2 id="property-title">
            Your Trees.
            <br />
            <span>Your Whole Property.</span>
          </h2>
          <p>
            Tree work is our focus, and there’s more we can help with.
            Landscaping, lawn care, land clearing, and seasonal cleanups give
            you a place to turn for the rest of your outdoor project, too.
          </p>
          <p>
            Whether you’re thinking about fresh mulch, regular mowing, or
            clearing out an overgrown space, tell us what you have in mind.
          </p>
          <div class="service-property-links">
            <a href="/services/landscaping/">
              Landscaping & Property Care <Icon name="arrow" size={16} />
            </a>
            <a href="/#our-work">
              See Our Work <Icon name="arrow" size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>
    <ServiceQuestions
      title="Find the Right Care for Your Trees."
      questions={questions}
      intro="A few helpful details before we talk about your trees, your property, and your next project."
    />
    <ServiceCallout
      title="Good Tree Care Starts Here."
      text={`Tell us what needs attention at your ${primaryLocation.city} property. We’ll talk through the work and start with a free estimate.`}
    />
  </main>
</SiteLayout>
